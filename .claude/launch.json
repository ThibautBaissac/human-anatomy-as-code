{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spikes-viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "spikes/viewer",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "app"
      ],
      "port": 5174
    }
  ]
}
