# Items Wikidata portant un FMA ID (P1402), avec UBERON (P1554), TA2, TA98 et labels fr/la/en.
# Complété par wikidata-uberon.rq (items à UBERON sans FMA) ; les deux exports sont concaténés dans wikidata-fma.csv.
SELECT ?item ?fma ?uberon ?ta2 ?ta98 ?fr ?la ?en WHERE {
  ?item wdt:P1402 ?fma .
  OPTIONAL { ?item wdt:P1554 ?uberon }
  OPTIONAL { ?item wdt:P7173 ?ta2 }
  OPTIONAL { ?item wdt:P1323 ?ta98 }
  OPTIONAL { ?item rdfs:label ?fr FILTER(LANG(?fr)="fr") }
  OPTIONAL { ?item rdfs:label ?la FILTER(LANG(?la)="la") }
  OPTIONAL { ?item rdfs:label ?en FILTER(LANG(?en)="en") }
}
