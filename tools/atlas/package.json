{
  "name": "@haac/atlas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "atlas": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "node src/cli.ts validate ../../data",
    "build": "node src/cli.ts build ../../data ../../build",
    "coverage": "node src/cli.ts coverage ../../data",
    "import-bp3d": "node src/cli.ts import-bp3d ../../data/raw/bodyparts3d ../../data/import/wikidata-fma.csv ../../data",
    "import-hra": "node src/cli.ts import-hra ../../data/raw/hra ../../data/import/wikidata-fma.csv ../../data"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3"
  }
}
