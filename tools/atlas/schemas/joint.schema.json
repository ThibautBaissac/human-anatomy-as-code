{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haac.example/schemas/joint.schema.json",
  "title": "Articulation animable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "labels",
    "motion",
    "proximal",
    "moving",
    "rangeDeg",
    "restDeg",
    "sources",
    "status",
    "fit"
  ],
  "properties": {
    "slug": {
      "$ref": "structure.schema.json#/$defs/slug"
    },
    "labels": {
      "$ref": "structure.schema.json#/$defs/labels"
    },
    "motion": {
      "enum": [
        "flexion-extension",
        "pronation-supination"
      ]
    },
    "proximal": {
      "$ref": "structure.schema.json#/$defs/slug"
    },
    "moving": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "structure.schema.json#/$defs/slug"
      }
    },
    "coupled": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bone",
          "ratio"
        ],
        "properties": {
          "bone": {
            "$ref": "structure.schema.json#/$defs/slug"
          },
          "ratio": {
            "type": "number"
          }
        }
      }
    },
    "parent": {
      "$ref": "structure.schema.json#/$defs/slug"
    },
    "rangeDeg": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "restDeg": {
      "type": "number"
    },
    "functionalArcDeg": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "status": {
      "$ref": "structure.schema.json#/$defs/status"
    },
    "fit": {
      "type": "object",
      "required": [
        "method",
        "maxRmsMm",
        "positiveDirection"
      ],
      "properties": {
        "method": {
          "enum": [
            "cylinder-contact",
            "head-to-head",
            "condyle-spheres"
          ]
        },
        "maxRmsMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "positiveDirection": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        ]
      }
    },
    "sides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "centre",
            "axis",
            "rmsMm"
          ],
          "properties": {
            "centre": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "axis": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "rmsMm": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "right": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "centre",
            "axis",
            "rmsMm"
          ],
          "properties": {
            "centre": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "axis": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "rmsMm": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
