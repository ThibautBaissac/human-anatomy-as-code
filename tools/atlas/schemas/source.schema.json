{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haac.example/schemas/source.schema.json",
  "title": "Source de données",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "url", "licence", "attribution", "provides"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://" },
    "licence": { "type": "string", "minLength": 1 },
    "attribution": { "type": "string", "minLength": 1 },
    "provides": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["meshes", "labels", "ids"] } },
    "meshPrefix": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "meshPattern": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "if": { "properties": { "provides": { "type": "array", "contains": { "const": "meshes" } } } },
  "then": { "required": ["meshPrefix", "meshPattern"] }
}
